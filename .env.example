# ===== Copie para .env e preencha. NUNCA suba o .env para o GitHub. =====

# --- Telegram (único canal) ---
TELEGRAM_BOT_TOKEN=            # @BotFather
TELEGRAM_ALLOWED_USER_IDS=     # SEU id numérico (@userinfobot). Só você fala com o Quíron.

# --- Cérebro (camada gratuita) ---
GEMINI_API_KEY=                # aistudio.google.com
GROQ_API_KEY=                  # console.groq.com
LLM_PRINCIPAL=gemini/gemini-flash-latest   # confirme o nome atual do modelo
LLM_RESERVA=groq/openai/gpt-oss-120b      # conferido em 04/10/2026 (o llama-3.3 foi aposentado)
# Fila de modelos grátis entre o principal e a reserva (cada Gemini tem cota diária própria; o Flash mais novo dá ~20/dia).
# Deixe a linha comentada para usar o padrão; vazio desliga.
# LLM_ALTERNATIVOS=gemini/gemini-3.7-flash,gemini/gemini-3.6-flash,gemini/gemini-flash-lite-latest
LLM_LOCAL=ollama/qwen2.5:3b                # versão offline (PC de 8 GB)
# Futuro: ANTHROPIC_API_KEY= / OPENROUTER_API_KEY=

# --- Outras fontes sociais (gratuitas) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Pesquisa e dados de mercado (gratuitos) ---
TAVILY_API_KEY=                # opcional; o Hermes já tem busca web
BRAPI_TOKEN=                   # brapi.dev, plano gratuito
# Banco Central, Tesouro, ANBIMA, CVM, IBGE: sem chave

# --- Google (Agenda, Drive para backup) ---
GOOGLE_CREDENTIALS_FILE=./segredos/google_credentials.json

# --- Terminal ---
TERMINAL_PORTA=8765            # acessível só pela rede Tailscale
TERMINAL_SENHA=                # camada extra de proteção

# Google Agenda (Fase 14) — credencial em segredos/google_oauth.json; autorize com "Quiron Google Agenda.bat"
GOOGLE_AGENDA_ID=               # vazio = sua agenda principal

# --- Geral ---
FUSO_HORARIO=America/Sao_Paulo
HOST_ATUAL=pc                  # pc (desenvolvimento) | oracle | minipc
RUNTIME_AGENTE=a_definir       # hermes | claude | bot_proprio (decidido na Fase 5)
